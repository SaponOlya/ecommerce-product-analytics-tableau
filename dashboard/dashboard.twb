      <aliases enabled='yes' />
      <column caption='Stage order' datatype='integer' name='[Calculation_0816430094757888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [event_type]&#13;&#10;    WHEN &quot;visit&quot; THEN 1&#13;&#10;    WHEN &quot;view&quot; THEN 2&#13;&#10;    WHEN &quot;add_to_cart&quot; THEN 3&#13;&#10;    WHEN &quot;checkout&quot; THEN 4&#13;&#10;    WHEN &quot;purchase&quot; THEN 5&#13;&#10;END' />
      </column>
      <column caption='Conversion from visit' datatype='real' name='[Calculation_0816430094860289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id]) / MIN({ FIXED : COUNTD(IF [event_type] = &quot;visit&quot; THEN [user_id] END) })' />
      </column>
      <column caption='Purchase Conversion by Segment' datatype='real' name='[Calculation_0816430096338946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [event_type] = &quot;purchase&quot; THEN [user_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([user_id])' />
      </column>
      <column caption='Visit-to-Purchase Conversion by Device' datatype='real' name='[Calculation_0816430100611075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;purchase&quot; THEN [user_id] END)&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED [device] :&#13;&#10;        COUNTD(IF [event_type] = &quot;visit&quot; THEN [user_id] END)&#13;&#10;    }&#13;&#10;)' />
      </column>
      <column caption='Visit-to-Purchase Conversion by Traffic Source' datatype='real' name='[Calculation_0816430102528004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;purchase&quot; THEN [user_id] END)&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED [traffic_source] :&#13;&#10;        COUNTD(IF [event_type] = &quot;visit&quot; THEN [user_id] END)&#13;&#10;    }&#13;&#10;)' />
      </column>
      <column caption='Funnel Conversion by Traffic Source' datatype='real' name='[Calculation_0816430103785477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED [traffic_source] :&#13;&#10;        COUNTD(IF [event_type] = &quot;visit&quot; THEN [user_id] END)&#13;&#10;    }&#13;&#10;)' />
      </column>
      <column caption='Purchase Conversion' datatype='real' name='[Calculation_1269978355212288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [event_type] = &quot;purchase&quot; THEN [user_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([user_id])' />
      </column>
      <column caption='user_events_ecommerce_product_analytics.csv' datatype='table' name='[__tableau_internal_object_id__].[user_events_ecommerce_product_analytics.csv_636C20308F7743C78B958E1D0E24B321]' role='measure' type='quantitative' />
      <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Hour' datatype='datetime' name='[event_time]' role='dimension' type='ordinal' />
      <drill-paths>
        <drill-path name='country, city'>
